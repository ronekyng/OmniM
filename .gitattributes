# OmniM git attributes
* text=auto eol=lf

# Sources that must stay LF
*.rs text eol=lf
*.toml text eol=lf
*.md text eol=lf
*.py text eol=lf
*.sh text eol=lf
*.ts text eol=lf
*.tsx text eol=lf
*.css text eol=lf
*.json text eol=lf
*.proto text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.html text eol=lf

# Windows scripts must stay CRLF
*.bat text eol=crlf
*.cmd text eol=crlf
*.ps1 text eol=crlf

# Binaries
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.webp binary
*.ico binary
*.woff binary
*.woff2 binary
*.ttf binary
*.rlib binary
*.omnim binary
